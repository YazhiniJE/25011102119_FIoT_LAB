    {
        "id": "cb9db83edfda07e9",
        "type": "function",
        "z": "f813a006250e1dc9",
        "name": "Extract OWM Data",
        "func": "let p = msg.payload;\nif (!p || !p.main || ['temp','humidity','pressure'].some(k => p.main[k] == null || !Number.isFinite(Number(p.main[k])))) { node.warn('OpenWeather response missing weather data'); return null; }\nlet m = p.main;\nreturn [{payload:'Condition: '+(p.weather?.[0]?.description || 'Unavailable')}, {payload:Number(m.temp)}, {payload:Number(m.humidity)}, {payload:Number(m.pressure)}];",
        "outputs": 4,
        "timeout": "",
        "noerr": 0,
