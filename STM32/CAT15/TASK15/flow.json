    {
        "id": "bf48d563aacf9a2e",
        "type": "function",
        "z": "f813a006250e1dc9",
        "name": "Drying Time & Formatting",
        "func": "let p = msg.payload;\nif (typeof p === 'string') { try { p = JSON.parse(p); } catch(e) { node.warn('Invalid sensor JSON'); return null; } }\nif (!p || ['temperature','humidity','pressure'].some(k => p[k] == null || p[k] === '' || !Number.isFinite(Number(p[k])))) { node.warn('Incomplete sensor readings'); return null; }\nlet t = Number(p.temperature), h = Number(p.humidity), pr = Number(p.pressure);\nif (pr > 2000) pr /= 100;\nif (h < 0 || h > 100 || pr <= 0) return null;\nlet factor = Math.max(0.4,h/60)*Math.max(0.5,28/Math.max(t,1));\nlet val = x => ({payload:x});\nlet hours = x => val('~'+(x*factor).toFixed(1)+' hours');\nreturn [val(t), val(t), val(h), {payload:t,topic:'Temperature (\u00b0C)'}, hours(4.5), hours(1.5), hours(2), val(pr)];",
        "outputs": 8,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 560,
        "wires": [
