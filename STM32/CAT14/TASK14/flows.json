[
    {
        "id": "flow_cat14_mqtt",
        "type": "tab",
        "label": "CAT14 - MQTT Good Morning Subscriber",
        "disabled": false,
        "info": "Receives Good Morning messages from STM32 publisher on stm32/data topic via broker.emqx.io"
    },
    {
        "id": "mqtt_broker_emqx",
        "type": "mqtt-broker",
        "name": "broker.emqx.io",
        "broker": "broker.emqx.io",
        "port": "1883",
        "clientid": "NodeRED_Subscriber_CAT14",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true,
        "autoUnsubscribe": true,
        "birthTopic": "",
        "birthQos": "0",
        "birthPayload": "",
        "birthMsg": {},
        "closeTopic": "",
        "closeQos": "0",
        "closePayload": "",
        "closeMsg": {},
        "willTopic": "",
        "willQos": "0",
        "willPayload": "",
        "willMsg": {},
        "sessionExpiry": ""
    },
    {
        "id": "mqtt_in_stm32_data",
        "type": "mqtt in",
        "z": "flow_cat14_mqtt",
        "name": "STM32 Data Subscriber",
        "topic": "stm32/data",
        "qos": "0",
        "datatype": "utf8",
        "broker": "mqtt_broker_emqx",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 160,
        "y": 200,
        "wires": [
            [
                "debug_stm32_data",
                "func_add_timestamp",
                "ui_text_message"
            ]
        ]
    },
    {
        "id": "debug_stm32_data",
        "type": "debug",
        "z": "flow_cat14_mqtt",
        "name": "MQTT Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 430,
        "y": 120,
        "wires": []
    },
    {
        "id": "func_add_timestamp",
        "type": "function",
        "z": "flow_cat14_mqtt",
        "name": "Add Timestamp",
        "func": "msg.payload = {\n    message: msg.payload,\n    topic: msg.topic,\n    timestamp: new Date().toLocaleString(),\n    count: (context.get('count') || 0) + 1\n};\ncontext.set('count', msg.payload.count);\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 200,
        "wires": [
            [
                "debug_timestamped",
                "ui_text_timestamp",
                "ui_text_count"
            ]
        ]
    },
    {
        "id": "debug_timestamped",
        "type": "debug",
        "z": "flow_cat14_mqtt",
        "name": "Timestamped Debug",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "x": 690,
        "y": 120,
        "wires": []
    },
    {
        "id": "dashboard_group_cat14",
        "type": "ui_group",
        "name": "STM32 MQTT Publisher",
        "tab": "dashboard_tab_cat14",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "dashboard_tab_cat14",
        "type": "ui_tab",
        "name": "CAT14 MQTT Monitor",
        "icon": "dashboard",
        "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "ui_text_message",
        "type": "ui_text",
        "z": "flow_cat14_mqtt",
        "group": "dashboard_group_cat14",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "Last Message",
        "label": "Message from STM32",
        "format": "{{msg.payload}}",
        "layout": "row-spread",
        "className": "",
        "x": 450,
        "y": 280,
        "wires": []
    },
    {
        "id": "ui_text_timestamp",
        "type": "ui_text",
        "z": "flow_cat14_mqtt",
        "group": "dashboard_group_cat14",
        "order": 2,
        "width": 0,
        "height": 0,
        "name": "Last Received At",
        "label": "Last Received",
        "format": "{{msg.payload.timestamp}}",
        "layout": "row-spread",
        "className": "",
        "x": 690,
        "y": 200,
        "wires": []
    },
    {
        "id": "ui_text_count",
        "type": "ui_text",
        "z": "flow_cat14_mqtt",
        "group": "dashboard_group_cat14",
        "order": 3,
        "width": 0,
        "height": 0,
        "name": "Message Count",
        "label": "Messages Received",
        "format": "{{msg.payload.count}}",
        "layout": "row-spread",
        "className": "",
        "x": 690,
        "y": 280,
        "wires": []
    }
]