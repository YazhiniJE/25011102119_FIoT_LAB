--cpu Cortex-M3
"player\startup_stm32f103xb.o"
"player\main.o"
"player\stm32f1xx_it.o"
"player\stm32f1xx_hal_msp.o"
"player\stm32f1xx_hal_gpio_ex.o"
"player\stm32f1xx_hal_uart.o"
"player\stm32f1xx_hal.o"
"player\stm32f1xx_hal_rcc.o"
"player\stm32f1xx_hal_rcc_ex.o"
"player\stm32f1xx_hal_gpio.o"
"player\stm32f1xx_hal_dma.o"
"player\stm32f1xx_hal_cortex.o"
"player\stm32f1xx_hal_pwr.o"
"player\stm32f1xx_hal_flash.o"
"player\stm32f1xx_hal_flash_ex.o"
"player\stm32f1xx_hal_exti.o"
"player\system_stm32f1xx.o"
